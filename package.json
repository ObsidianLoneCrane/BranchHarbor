{
  "name": "branchharbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:project": "node scripts/check-project.mjs",
    "test:credentials": "cargo test --manifest-path src-tauri/Cargo.toml --locked native_credential_round_trip -- --ignored",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:project"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@lucide/vue": "1.66.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vue/test-utils": "2.5.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
